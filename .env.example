# ==============================================================================
# IoTong Environment Configuration Template
# Salin (copy) file ini menjadi '.env' lalu sesuaikan nilainya:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# --- KONEKSI SERIAL ESP32 ---
# Isi dengan nama port (contoh: COM3, COM4, COM5 di Windows, atau /dev/ttyUSB0 di Linux)
# Isi "AUTO" untuk mendeteksi port ESP32 secara otomatis saat dicolok
SERIAL_PORT=AUTO
BAUD_RATE=115200

# --- SUMBER KAMERA / WEBCAM ---
# SELECT = Tampilkan menu pilihan kamera yang terhubung saat program mulai
# 0      = Kamera utama / internal laptop
# 1      = Webcam USB eksternal
# Atau URL streaming IP Camera / ESP32-CAM (contoh: http://192.168.1.50:81/stream)
CAMERA_SOURCE=SELECT
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- PENGATURAN DETEKSI AI (YOLO) ---
# Nama atau path file model YOLO:
# - 'yolo11s_waste.pt' -> Model khusus sampah (kategori: paper, plastic, organic, metal, glass)
# - 'yolo11n.pt'       -> Model umum COCO bawaan
MODEL_PATH=yolo11s_waste.pt
# Ambang batas tampilan kamera (0.1 - 1.0, disarankan 0.30 - 0.45)
CONF_THRESHOLD=0.35
# Ambang batas minimal untuk memutar servo (hanya berputar jika keyakinan >= 80%)
SERVO_TRIGGER_CONF=0.80
# Jeda waktu (detik) antar pengiriman perintah servo ke ESP32
ACTION_COOLDOWN=3.0

# --- FILTER ANTI-FALSE-POSITIVE (MANUSIA / PAKAIAN) ---
# Batas maksimal luas kotak sampah (0.35 = max 35% luas layar, di atas itu dianggap badan manusia/baju)
MAX_BOX_AREA_RATIO=0.35
# Hanya proses sampah yang berada di kotak tengah (Drop Zone)
USE_ROI=true
# Jumlah frame berturut-turut objek harus stabil sebelum servo bergerak (mencegah flicker orang lewat)
STABLE_FRAMES_REQUIRED=3

# --- TAMPILAN ---
# true = Buka jendela visualisasi kamera dengan bounding box
# false = Jalankan tanpa antarmuka GUI (cocok untuk server/headless)
SHOW_GUI=true
# Flip horizontal kamera (true = gerakan searah tangan pengguna/cermin alami, false = raw sensor)
# Tekan tombol 'm' di jendela kamera untuk toggle secara langsung
FLIP_HORIZONTAL=true
