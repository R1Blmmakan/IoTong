# ==============================================================================
# IoTong Environment Configuration Template
# Salin (copy) file ini menjadi '.env' lalu sesuaikan nilainya:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# --- KONEKSI SERIAL ESP32 ---
# Isi dengan nama port (contoh: COM3, COM4, COM5 di Windows, atau /dev/ttyUSB0 di Linux)
# Isi "AUTO" untuk mendeteksi port ESP32 secara otomatis saat dicolok
SERIAL_PORT=AUTO
BAUD_RATE=115200

# --- SUMBER KAMERA / WEBCAM ---
# 0 = Webcam internal laptop (default)
# 1 = Kamera eksternal / webcam USB kedua
# Atau URL streaming ESP32-CAM / IP Camera (contoh: http://192.168.1.50:81/stream)
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- PENGATURAN DETEKSI AI (YOLO) ---
# Nama atau path file model YOLO (akan diunduh otomatis jika belum ada)
MODEL_PATH=yolo11n.pt
# Ambang batas kepercayaan deteksi (0.1 - 1.0)
CONF_THRESHOLD=0.55
# Jeda waktu (detik) antar pengiriman perintah servo ke ESP32
ACTION_COOLDOWN=3.0

# --- TAMPILAN ---
# true = Buka jendela visualisasi kamera dengan bounding box
# false = Jalankan tanpa antarmuka GUI (cocok untuk server/headless)
SHOW_GUI=true
